.animation-preview {
    position: relative;
    height: 280px;
    min-height: 280px;
    flex-shrink: 0;
    margin-top: 16px;
    margin-bottom: 12px;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--bl-background);
}

.animation-preview > .appui-navhost {
    height: 100%;
    min-height: 280px;
}

.animation-screen {
    flex-grow: 1;
    padding: 28px;
    justify-content: center;
    gap: 16px;
}

.animation-screen--home {
    background-color: var(--bl-surface);
}

.animation-screen--details {
    background-color: var(--bl-selection);
}

.animation-popup-backdrop {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.animation-popup {
    max-width: 420px;
    flex-grow: 0;
    flex-basis: auto;
    background-color: var(--bl-panel);
}

.animation-transition-row {
    margin-top: 20px;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
}

.transition-card {
    max-width: 520px;
    flex-grow: 1;
    opacity: 0.45;
    background-color: var(--bl-surface);
    transition-property: opacity, background-color;
    transition-duration: 650ms;
    transition-timing-function: ease-in-out;
}

.transition-card--active {
    opacity: 1;
    background-color: var(--bl-selection);
}

.animation-transition-controls {
    min-width: 240px;
    max-width: 340px;
    gap: 10px;
}

.animation-status {
    font-size: 18px;
    white-space: normal;
}
