.fixture { flex-grow: 1; background-color: rgb(25, 30, 39); padding: 20px; }
.title { color: white; font-size: 24px; margin-bottom: 14px; }
.toolbar { flex-direction: row; gap: 8px; margin-bottom: 18px; }
.cases { flex-direction: row; flex-wrap: wrap; gap: 20px; }
.case { width: 290px; height: 230px; border-width: 2px; border-color: rgb(100, 115, 135); }
.case > Label { color: white; background-color: rgb(40, 45, 55); font-size: 14px; }
.opaque { background-color: rgb(65, 75, 90); }
.transparent { background-color: rgba(150, 180, 220, 0.15); }
.particles { position: absolute; left: 15px; top: 40px; right: 0; bottom: 0; }
.front { position: absolute; left: 25px; top: 100px; width: 230px; height: 45px; }
.rectangular { overflow: hidden; }
.rounded { overflow: hidden; border-radius: 55px; }
.scroll { height: 190px; }
.scroll-particles { height: 600px; min-height: 600px; width: 260px; }
.faded { opacity: 0.5; transition-property: opacity; transition-duration: 1s; }
.overlay-origin { position: absolute; left: 60px; bottom: 50px; width: 180px; height: 30px; background-color: white; }
.overlay-particles { position: absolute; left: 240px; top: -40px; width: 240px; height: 70px; }
.benchmark { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; }
.benchmark-control { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.masked { overflow: hidden; border-radius: 100px; }
