.anchor-sample {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 48px;
    background-color: rgb(18, 21, 28);
}

.anchor-sample__card {
    width: 520px;
    max-width: 100%;
    padding: 40px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-bottom-left-radius: 16px;
    background-color: rgb(31, 36, 47);
}

.anchor-sample__eyebrow {
    margin-bottom: 12px;
    color: rgb(93, 205, 255);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.anchor-sample__title {
    margin-bottom: 12px;
    color: rgb(245, 247, 250);
    font-size: 34px;
    -unity-font-style: bold;
    white-space: normal;
}

.anchor-sample__body {
    color: rgb(183, 191, 207);
    font-size: 16px;
    white-space: normal;
}
