.anchor-sample {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background-color: var(--bl-background);
}

.anchor-sample__card {
    width: 520px;
    max-width: 100%;
    padding: 24px;
    border-top-left-radius: var(--bl-radius-large);
    border-top-right-radius: var(--bl-radius-large);
    border-bottom-right-radius: var(--bl-radius-large);
    border-bottom-left-radius: var(--bl-radius-large);
    background-color: var(--bl-panel);
}

.anchor-sample__eyebrow {
    margin-bottom: 12px;
    color: var(--bl-secondary-accent);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
}

.anchor-sample__title {
    margin-bottom: 12px;
    color: var(--bl-text);
    font-size: var(--bl-title-size);
    -unity-font-style: bold;
    white-space: normal;
}

.anchor-sample__body {
    color: var(--bl-text-muted);
    font-size: 16px;
    white-space: normal;
}
