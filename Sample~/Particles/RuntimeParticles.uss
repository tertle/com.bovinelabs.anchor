.particle-example { flex-grow: 1; padding: 16px; background-color: rgb(19, 24, 34); color: rgb(230, 235, 245); }
.title { font-size: 22px; margin-bottom: 12px; }
.particle-toolbar { flex-direction: row; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
.particle-cards { flex-direction: row; flex-wrap: wrap; gap: 12px; }
.particle-card { width: 280px; height: 210px; background-color: rgb(35, 43, 59); border-radius: 8px; padding: 14px; }
.clipped-card { overflow: hidden; }
.sparkle-button { margin-top: 70px; height: 40px; }
.particle-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
